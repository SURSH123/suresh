class Solution {
    public String dayOfTheWeek(int day, int month, int year) {

        String[] week = {
            "Sunday", "Monday", "Tuesday",
            "Wednesday", "Thursday", "Friday",
            "Saturday"
        };

        int totalDays = 0;

        // Calculate days from 1971 to given year
        for (int y = 1971; y < year; y++) {
            if (isLeapYear(y)) {
                totalDays += 366;
            } else {
                totalDays += 365;
            }
        }

        int[] days = {
            31, 28, 31, 30, 31, 30,
            31, 31, 30, 31, 30, 31
        };

        // Leap year
        if (isLeapYear(year)) {
            days[1] = 29;
        }

        // Add days of previous months
        for (int m = 0; m < month - 1; m++) {
            totalDays += days[m];
        }

        // Add days of current month
        totalDays += day - 1;

        // January 1, 1971 = Friday
        int index = (5 + totalDays) % 7;

        return week[index];
    }

    private boolean isLeapYear(int year) {
        return (year % 400 == 0) ||
               (year % 4 == 0 && year % 100 != 0);
    }
}


